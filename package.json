{
  "name": "metaball-generator",
  "private": true,
  "version": "1.0.0",
  "description": "NAMCHE metaball brandmark generator — engine and editor",
  "type": "module",
  "workspaces": ["core", "editor"],
  "scripts": {
    "build": "npm run build -w @namche/metaball && npm run build -w metaball-editor",
    "build:core": "npm run build -w @namche/metaball",
    "dev": "npm run dev -w metaball-editor",
    "test": "npm run test -w @namche/metaball",
    "bake": "node scripts/bake-assets.mjs",
    "sync:design": "node scripts/sync-design.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
