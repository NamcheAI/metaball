# The editor is public: no authentication env vars are needed to run it.

# Optional server-only AI material rendering. Never expose this as a VITE_* variable.
# WARNING: /api/render has no authentication. Do not set this on a public
# deployment without adding some other protection first -- every visitor who
# can reach the deployment can trigger a render and spend the linked
# provider credits.
OPENAI_API_KEY=your-openai-api-key
# OPENAI_IMAGE_MODEL=gpt-image-2
