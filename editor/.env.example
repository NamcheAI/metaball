# Required in every Vercel-style runtime. Plain `npm run dev` stays open because
# it serves Vite directly without invoking the middleware.
AUTH_PIN=your-pin-here
AUTH_SECRET=generate-a-long-random-string
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Deliberate opt-out for an intentionally public Vercel deployment only:
# AUTH_DISABLED=1
